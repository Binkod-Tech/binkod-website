{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/public/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/public/favicon/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/device-matrix/plans",
      "destination": "/device-matrix/remove-ads/",
      "permanent": true
    },
    {
      "source": "/device-matrix/plans/",
      "destination": "/device-matrix/remove-ads/",
      "permanent": true
    },
    {
      "source": "/device-matrix/plans/:path*",
      "destination": "/device-matrix/remove-ads/",
      "permanent": true
    },
    {
      "source": "/family-path",
      "destination": "/family-path-locator/",
      "permanent": true
    },
    {
      "source": "/family-path/:path*",
      "destination": "/family-path-locator/:path*",
      "permanent": true
    }
  ]
}
